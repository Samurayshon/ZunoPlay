<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!--
      Android launcher foreground derived from the canonical ZunoBrand.headSvg()
      used by the Central navigation button. The outer scale keeps the same
      artwork inside Android adaptive-icon safe bounds without changing it.
    -->
    <group
        android:pivotX="60"
        android:pivotY="60"
        android:scaleX="0.78"
        android:scaleY="0.78">

        <!-- Canonical purple aura; SVG blur is approximated by alpha on Android. -->
        <path
            android:fillColor="#7D4DFF"
            android:fillAlpha="0.13"
            android:pathData="M106,61 A46,43 0,1 1,14 61 A46,43 0,1 1,106 61Z" />

        <!-- Lightning shadow. -->
        <path
            android:fillColor="#0B0D12"
            android:fillAlpha="0.70"
            android:pathData="M67,4 L48,32 L58,32 L53,56 L75,25 L64,25 L67,4Z" />

        <!-- Canonical lightning. -->
        <path
            android:strokeColor="#47FFFFFF"
            android:strokeWidth="1.1"
            android:strokeLineJoin="round"
            android:pathData="M66,2 L47,30 L57,30 L52,54 L74,23 L63,23 L66,2Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="47"
                    android:startY="2"
                    android:endX="74"
                    android:endY="54"
                    android:type="linear">
                    <item android:offset="0" android:color="#22D3EE" />
                    <item android:offset="0.28" android:color="#4F7BFF" />
                    <item android:offset="0.55" android:color="#A855F7" />
                    <item android:offset="0.80" android:color="#F0338C" />
                    <item android:offset="1" android:color="#FF7A3C" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Left headset shell. -->
        <path android:pathData="M12,49 H12 C16.4,49 20,52.6 20,57 V71 C20,75.4 16.4,79 12,79 C7.6,79 4,75.4 4,71 V57 C4,52.6 7.6,49 12,49Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="7.2"
                    android:startY="49"
                    android:endX="16.8"
                    android:endY="79"
                    android:type="linear">
                    <item android:offset="0" android:color="#4C5361" />
                    <item android:offset="0.45" android:color="#242933" />
                    <item android:offset="1" android:color="#0E1014" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Right headset shell. -->
        <path android:pathData="M108,49 H108 C112.4,49 116,52.6 116,57 V71 C116,75.4 112.4,79 108,79 C103.6,79 100,75.4 100,71 V57 C100,52.6 103.6,49 108,49Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="103.2"
                    android:startY="49"
                    android:endX="112.8"
                    android:endY="79"
                    android:type="linear">
                    <item android:offset="0" android:color="#4C5361" />
                    <item android:offset="0.45" android:color="#242933" />
                    <item android:offset="1" android:color="#0E1014" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Left headset accent. -->
        <path android:pathData="M12,57 H12 C14.2,57 16,58.8 16,61 V67 C16,69.2 14.2,71 12,71 C9.8,71 8,69.2 8,67 V61 C8,58.8 9.8,57 12,57Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="8"
                    android:startY="57"
                    android:endX="16"
                    android:endY="71"
                    android:type="linear">
                    <item android:offset="0" android:color="#22D3EE" />
                    <item android:offset="0.28" android:color="#4F7BFF" />
                    <item android:offset="0.55" android:color="#A855F7" />
                    <item android:offset="0.80" android:color="#F0338C" />
                    <item android:offset="1" android:color="#FF7A3C" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Right headset accent. -->
        <path android:pathData="M108,57 H108 C110.2,57 112,58.8 112,61 V67 C112,69.2 110.2,71 108,71 C105.8,71 104,69.2 104,67 V61 C104,58.8 105.8,57 108,57Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="104"
                    android:startY="57"
                    android:endX="112"
                    android:endY="71"
                    android:type="linear">
                    <item android:offset="0" android:color="#22D3EE" />
                    <item android:offset="0.28" android:color="#4F7BFF" />
                    <item android:offset="0.55" android:color="#A855F7" />
                    <item android:offset="0.80" android:color="#F0338C" />
                    <item android:offset="1" android:color="#FF7A3C" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Canonical mascot shell: rect 14,27 92x80 rx=34. -->
        <path
            android:strokeColor="#99626A7A"
            android:strokeWidth="1"
            android:pathData="M48,27 H72 C90.8,27 106,42.2 106,61 V73 C106,91.8 90.8,107 72,107 H48 C29.2,107 14,91.8 14,73 V61 C14,42.2 29.2,27 48,27Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="32.4"
                    android:startY="27"
                    android:endX="87.6"
                    android:endY="107"
                    android:type="linear">
                    <item android:offset="0" android:color="#4C5361" />
                    <item android:offset="0.45" android:color="#242933" />
                    <item android:offset="1" android:color="#0E1014" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Canonical face glass: rect 25,41 70x51 rx=24. -->
        <path
            android:strokeColor="#3C4658"
            android:strokeWidth="1"
            android:pathData="M49,41 H71 C84.3,41 95,51.7 95,65 V68 C95,81.3 84.3,92 71,92 H49 C35.7,92 25,81.3 25,68 V65 C25,51.7 35.7,41 49,41Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="50.2"
                    android:centerY="52.2"
                    android:gradientRadius="63">
                    <item android:offset="0" android:color="#1D2635" />
                    <item android:offset="0.52" android:color="#080A0F" />
                    <item android:offset="1" android:color="#000000" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.13"
            android:pathData="M31,52 C38,44 49,40 61,42 C47,45 37,51 31,61 C29,58 29,55 31,52Z" />

        <!-- Cyan eye glow from the canonical Central mascot. -->
        <path
            android:fillColor="#37E6E0"
            android:fillAlpha="0.28"
            android:pathData="M56,64 A10,12 0,1 1,36 64 A10,12 0,1 1,56 64Z" />
        <path
            android:fillColor="#37E6E0"
            android:fillAlpha="0.28"
            android:pathData="M84,64 A10,12 0,1 1,64 64 A10,12 0,1 1,84 64Z" />

        <path
            android:fillColor="#FFFFFF"
            android:pathData="M53.5,64 A7.5,9.5 0,1 1,38.5 64 A7.5,9.5 0,1 1,53.5 64Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M81.5,64 A7.5,9.5 0,1 1,66.5 64 A7.5,9.5 0,1 1,81.5 64Z" />
        <path
            android:fillColor="#37E6E0"
            android:fillAlpha="0.78"
            android:pathData="M45.9,60.5 A2.4,2.8 0,1 1,41.1 60.5 A2.4,2.8 0,1 1,45.9 60.5Z" />
        <path
            android:fillColor="#37E6E0"
            android:fillAlpha="0.78"
            android:pathData="M73.9,60.5 A2.4,2.8 0,1 1,69.1 60.5 A2.4,2.8 0,1 1,73.9 60.5Z" />

        <!-- Canonical gradient smile. -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:pathData="M49,78 Q60,88 71,78">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="49"
                    android:startY="78"
                    android:endX="71"
                    android:endY="88"
                    android:type="linear">
                    <item android:offset="0" android:color="#22D3EE" />
                    <item android:offset="0.28" android:color="#4F7BFF" />
                    <item android:offset="0.55" android:color="#A855F7" />
                    <item android:offset="0.80" android:color="#F0338C" />
                    <item android:offset="1" android:color="#FF7A3C" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Canonical lower status dot. -->
        <path android:pathData="M64.4,100 A4.4,4.4 0,1 1,55.6 100 A4.4,4.4 0,1 1,64.4 100Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="55.6"
                    android:startY="95.6"
                    android:endX="64.4"
                    android:endY="104.4"
                    android:type="linear">
                    <item android:offset="0" android:color="#22D3EE" />
                    <item android:offset="0.28" android:color="#4F7BFF" />
                    <item android:offset="0.55" android:color="#A855F7" />
                    <item android:offset="0.80" android:color="#F0338C" />
                    <item android:offset="1" android:color="#FF7A3C" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
